# OpenAI — search assistant parser (Vercel env name: OPENAI)
OPENAI=sk-...
OPENAI_SEARCH_MODEL=gpt-4o-mini

# Clerk (from dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics — set one or both. Google Analytics 4 is free.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# From analytics.google.com → Admin → Data streams → Measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site URL for metadata, sitemaps, and structured data
NEXT_PUBLIC_APP_URL=https://explore-summer.com

# Resend — contact form + waitlist (resend.com → API Keys)
# Use a Full Access key (send-only keys cannot add contacts to segments).
RESEND_API_KEY=re_...
# Inbox that receives contact form submissions (can be your personal email)
CONTACT_EMAIL_TO=you@example.com
# Sender address. Use onboarding@resend.dev for testing; verify your domain in Resend for production
CONTACT_EMAIL_FROM=Explore Summer <onboarding@resend.dev>
# Resend segment ID for 2027 update sign-ups (Resend → Contacts → Segments → create "2027 updates")
RESEND_WAITLIST_SEGMENT_ID=
